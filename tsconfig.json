{
  "compilerOptions": {
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./types",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["./src/"],
  "exclude": ["./example/", "./website/", "./types/"]
}
